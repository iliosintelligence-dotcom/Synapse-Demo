{
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/m/:path*",
      "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/storage/v1/render/image/public/:path*?width=1080&height=1080&resize=contain&quality=85"
    },
    {
      "source": "/s/:token",
      "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/functions/v1/short-link/:token"
    },
    {
      "source": "/s/:token/",
      "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/functions/v1/short-link/:token"
    },
    {
      "source": "/go/:handle",
      "destination": "/app/go/?h=:handle"
    },
    {
      "source": "/go/:handle/",
      "destination": "/app/go/?h=:handle"
    },
    {
      "source": "/your-data",
      "destination": "/app/your-data/"
    },
    {
      "source": "/your-data/",
      "destination": "/app/your-data/"
    },
    {
      "source": "/app/go.html",
      "destination": "/app/go/"
    },
    {
      "source": "/app/your-data.html",
      "destination": "/app/your-data/"
    },
    {
      "source": "/app/synapse.html",
      "destination": "/app/synapse/"
    },
    {
      "source": "/app/synapse-join.html",
      "destination": "/app/synapse-join/"
    },
    {
      "source": "/app/verify.html",
      "destination": "/app/verify/"
    },
    {
      "source": "/app/syndication-test.html",
      "destination": "/app/syndication-test/"
    },
    {
      "source": "/buyers.html",
      "destination": "/buyers/"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/"
    },
    {
      "source": "/terms.html",
      "destination": "/terms/"
    },
    {
      "source": "/index.html",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/tayo",
      "destination": "/chat/?via=bio",
      "permanent": false
    },
    {
      "source": "/tayo/",
      "destination": "/chat/?via=bio",
      "permanent": false
    },
    {
      "source": "/tayo/:ch",
      "destination": "/chat/?via=bio&ch=:ch",
      "permanent": false
    },
    {
      "source": "/agencies",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agencies.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app/toju.html",
      "destination": "/chat/",
      "permanent": false
    },
    {
      "source": "/app/browse.html",
      "destination": "/browse/",
      "permanent": false
    },
    {
      "source": "/app/property.html",
      "destination": "/property/",
      "permanent": false
    },
    {
      "source": "/app/dream.html",
      "destination": "/dream/",
      "permanent": false
    },
    {
      "source": "/app/signin.html",
      "destination": "/signin/",
      "permanent": false
    },
    {
      "source": "/app/agency-profile.html",
      "destination": "/agency/",
      "permanent": false
    },
    {
      "source": "/app/agency.html",
      "destination": "/portal/",
      "permanent": false
    },
    {
      "source": "/tayo/:ch/",
      "destination": "/chat/?via=bio&ch=:ch",
      "permanent": false
    },
    {
      "source": "/agencies/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self), payment=(self), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
