{
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/m/:path*", "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/storage/v1/render/image/public/:path*?width=1080&height=1080&resize=contain&quality=85" },
    { "source": "/s/:token", "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/functions/v1/short-link/:token" }
  ],
  "redirects": [
    { "source": "/tayo", "destination": "/chat/?via=bio", "permanent": false },
    { "source": "/tayo/", "destination": "/chat/?via=bio", "permanent": false },
    { "source": "/tayo/:ch", "destination": "/chat/?via=bio&ch=:ch", "permanent": false },

    { "source": "/app/toju.html", "destination": "/chat/", "permanent": false },
    { "source": "/app/browse.html", "destination": "/browse/", "permanent": false },
    { "source": "/app/property.html", "destination": "/property/", "permanent": false },
    { "source": "/app/dream.html", "destination": "/dream/", "permanent": false },
    { "source": "/app/signin.html", "destination": "/signin/", "permanent": false },
    { "source": "/app/agency-profile.html", "destination": "/agency/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(self), microphone=(self), payment=(self), interest-cohort=()" }
      ]
    }
  ]
}
