{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/m/:path*",
      "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/storage/v1/render/image/public/:path*?width=1080&height=1080&resize=contain&quality=85"
    },
    {
      "source": "/s/:token",
      "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/functions/v1/short-link/:token"
    },
    {
      "source": "/go/:handle",
      "destination": "/app/go?h=:handle"
    },
    {
      "source": "/your-data",
      "destination": "/app/your-data"
    }
  ],
  "redirects": [
    {
      "source": "/agencies",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agencies.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tayo",
      "destination": "/app/toju?via=bio",
      "permanent": false
    },
    {
      "source": "/tayo/:ch",
      "destination": "/app/toju?via=bio&ch=:ch",
      "permanent": false
    },
    {
      "source": "/chat",
      "destination": "/app/toju",
      "permanent": false
    },
    {
      "source": "/browse",
      "destination": "/app/browse",
      "permanent": false
    },
    {
      "source": "/property",
      "destination": "/app/property",
      "permanent": false
    },
    {
      "source": "/dream",
      "destination": "/app/dream",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "/app/signin",
      "permanent": false
    },
    {
      "source": "/agency",
      "destination": "/app/agency-profile",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "/app/agency",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self), payment=(self), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
