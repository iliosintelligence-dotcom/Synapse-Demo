{
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "https://bhrhejpekmhbhwryjhgk.supabase.co/functions/v1/short-link/:token"
    },
    {
      "source": "/go/:handle",
      "destination": "/app/go.html?h=:handle"
    }
  ],
  "redirects": [
    {
      "source": "/agencies.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agencies",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
