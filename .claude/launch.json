{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "synapse",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "."],
      "autoPort": true
    },
    {
      "name": "synapse-trae",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../Synapse Trae/node_modules/next/dist/bin/next",
        "dev",
        "../Synapse Trae",
        "-p",
        "3005"
      ],
      "port": 3005
    }
  ]
}
